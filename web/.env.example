# Copy to web/.env.
#
# VITE_APP_ENV decides the environment:
#   dev -> use the Firebase emulators + dev conveniences (prefilled login)
#   prd -> use the real Firebase project below
# scripts/dev.sh sets VITE_APP_ENV=dev automatically, so the emulator needs none
# of the VITE_FIREBASE_* values.

VITE_APP_ENV=prd

